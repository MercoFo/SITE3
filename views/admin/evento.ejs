<%- include('_topo', { tituloAdmin: 'Evento atual' }) %>
<h1>Evento atual</h1>
<p class="intro">Este bloco aparece com destaque na página inicial. Atualize a cada encontro.</p>
<% if (erro) { %><p class="aviso erro" role="alert"><%= erro %></p><% } %>
<form method="post" enctype="multipart/form-data" class="formulario">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="caixa"><input type="checkbox" name="evento_ativo" value="1" <%= cfg.evento_ativo === '1' ? 'checked' : '' %>> Mostrar o bloco do evento na página inicial</label>
  <div class="duas">
    <label>Nome do evento <small>o número romano no início fica em vermelho</small><input name="evento_nome" value="<%= cfg.evento_nome %>" maxlength="120" placeholder="XXI FoMerco"></label>
    <label>Datas<input name="evento_datas" value="<%= cfg.evento_datas %>" maxlength="120" placeholder="10 a 12 de setembro de 2027"></label>
  </div>
  <label>Tema<input name="evento_tema" value="<%= cfg.evento_tema %>" maxlength="300"></label>
  <label>Local<input name="evento_local" value="<%= cfg.evento_local %>" maxlength="200" placeholder="Cidade, instituição"></label>
  <label>Texto curto<textarea name="evento_texto" rows="3" maxlength="1200"><%= cfg.evento_texto %></textarea></label>
  <div class="duas">
    <label>Link do site do evento (Even3)<input name="evento_link" type="url" value="<%= cfg.evento_link %>" maxlength="500" placeholder="https://www.even3.com.br/..."></label>
    <label>Texto do botão<input name="evento_botao" value="<%= cfg.evento_botao %>" maxlength="60"></label>
  </div>
  <fieldset>
    <legend>Skylines da faixa do evento</legend>
    <p class="nota">Silhuetas da cidade do encontro, em PNG com fundo transparente. A de cima aparece de cabeça para baixo, pendurada no topo da faixa, e a de baixo apoiada no rodapé dela. Sem envio, ficam as de São Paulo do XXI FoMerco.</p>
    <div class="duas">
      <div class="skyline-campo">
        <img class="miniatura escura" src="<%= img.topo %>" alt="Skyline atual do topo">
        <label>Trocar skyline do topo <small>PNG transparente, até 5 MB</small><input type="file" name="skyline_topo" accept="image/png,image/webp"></label>
        <% if (cfg.evento_topo_id) { %><label class="caixa"><input type="checkbox" name="remover_skyline_topo" value="1"> Voltar para a padrão</label><% } %>
      </div>
      <div class="skyline-campo">
        <img class="miniatura escura" src="<%= img.base %>" alt="Skyline atual da base">
        <label>Trocar skyline da base <small>PNG transparente, até 5 MB</small><input type="file" name="skyline_base" accept="image/png,image/webp"></label>
        <% if (cfg.evento_base_id) { %><label class="caixa"><input type="checkbox" name="remover_skyline_base" value="1"> Voltar para a padrão</label><% } %>
      </div>
    </div>
  </fieldset>
  <div class="barra"><button class="botao">Salvar alterações</button></div>
</form>
<%- include('_fim') %>
